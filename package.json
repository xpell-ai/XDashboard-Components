{
  "name": "@xpell/xdashboard",
  "version": "2.0.8",
  "description": "Dashboard XUI component library for Xpell UI",
  "private": false,
  "type": "module",
  "author": "Tamir Fridman",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./skills": {
      "types": "./dist/types/skills.d.ts",
      "import": "./dist/skills.js",
      "require": "./dist/skills.cjs"
    },
    "./xdashboard.css": "./dist/xdashboard.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "test": "pnpm run test:foundation && pnpm run test:core2026 && pnpm run test:data2026 && pnpm run test:composition2026 && pnpm run test:toolbar-igroup && pnpm run test:xbadge && pnpm run test:xcard && pnpm run test:xsection && pnpm run test:xgallery && pnpm run test:xlist && pnpm run test:xtimeline && pnpm run test:xcalendar && pnpm run test:xkanban && pnpm run test:xstats && pnpm run test:shared-xdata && pnpm run test:skill && pnpm run test:discovery",
    "test:foundation": "node tests/xdashboard-foundations.mjs",
    "test:core2026": "node tests/xdashboard-core-2026.mjs",
    "test:data2026": "node tests/xdashboard-data-2026.mjs",
    "test:composition2026": "node tests/xdashboard-composition-2026.mjs",
    "test:toolbar-igroup": "node --import ./tests/register-css-loader.mjs tests/toolbar-igroup-semantic.mjs",
    "test:xbadge": "node --import ./tests/register-css-loader.mjs tests/xbadge.mjs",
    "test:xcard": "node --import ./tests/register-css-loader.mjs tests/xcard-regression.mjs",
    "test:xsection": "node --import ./tests/register-css-loader.mjs tests/xsection.mjs",
    "test:xgallery": "node --import ./tests/register-css-loader.mjs tests/xgallery.mjs",
    "test:xlist": "node --import ./tests/register-css-loader.mjs tests/xlist.mjs",
    "test:xtimeline": "node --import ./tests/register-css-loader.mjs tests/xtimeline.mjs",
    "test:xcalendar": "node --import ./tests/register-css-loader.mjs tests/xcalendar.mjs",
    "test:xkanban": "node --import ./tests/register-css-loader.mjs tests/xkanban.mjs",
    "test:xstats": "node --import ./tests/register-css-loader.mjs tests/xstats.mjs",
    "test:shared-xdata": "node --import ./tests/register-css-loader.mjs tests/shared-xdata.mjs",
    "test:skill": "node --import ./tests/register-css-loader.mjs tests/skill-design.mjs",
    "test:discovery": "node --import ./tests/register-css-loader.mjs tests/skill-discovery-node.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "peerDependencies": {
    "@xpell/core": "workspace:*"
  },
  "dependencies": {
    "@xpell/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpell-ai/XDashboard-Components.git"
  }
}
